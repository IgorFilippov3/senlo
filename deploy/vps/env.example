# Database Configuration
DATABASE_URL=postgresql://senlo_user:senlo_password@db:5432/senlo_db

# Redis Configuration (required for BullMQ)
REDIS_URL=redis://redis:6379

# Authentication
# Generate a secret using: openssl rand -base64 32
AUTH_SECRET="YOUR_AUTH_SECRET_HERE"

# Required for VPS deployment to trust the host IP/Domain
AUTH_TRUST_HOST=true

# Registration Control
# Set to "false" to disable public registration.
ALLOW_REGISTRATION="true"

# Demo Mode
# Set to "true" only for a public demo instance.
# Two effects: new accounts are seeded with a worked example (contacts,
# automations and a month of invented delivery history) instead of the plain
# starter project, and a banner marks that data as fabricated. Leave "false"
# on a real instance — those numbers must never look like your own sending.
IS_DEMO_MODE="false"
NEXT_PUBLIC_IS_DEMO_MODE="false"

# Application URL
# Replace with your server's IP or domain (including port if not 80/443)
# Example: http://95.213.11.22:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Admin Users (for PRIVATE mode or first run)
# Format: '[{"name": "Admin", "email": "admin@example.com", "password": "secure_password", "role": "ADMIN"}]'
INITIAL_USERS='[]'

