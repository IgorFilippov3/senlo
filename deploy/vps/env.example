# All variables are read when the containers start, not when the image is
# built: change a value and restart, no rebuild needed. A missing required
# value stops the app and the worker with a list of what to fix.

# --- Required ---------------------------------------------------------------

# Database
DATABASE_URL=postgresql://senlo_user:senlo_password@db:5432/senlo_db

# Signs sessions, and unsubscribe and tracking links in outgoing mail.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="YOUR_AUTH_SECRET_HERE"

# The address Senlo is reached at: the domain your reverse proxy serves.
# Links in outgoing mail point here. Example: https://mail.example.com
# (The old name NEXT_PUBLIC_APP_URL is still accepted.)
APP_URL="http://localhost:3000"

# Encrypts provider credentials (API keys, SMTP passwords) in the database.
# Set it on the first install and never change it: rows sealed with one key
# cannot be read with another. Back it up with the database.
# Generate one with: openssl rand -base64 32
# Left empty, AUTH_SECRET is used, and rotating AUTH_SECRET would then lock
# every stored credential (see "Encryption key" in README.md).
SECRETS_KEY=""

# --- Optional ---------------------------------------------------------------

# Redis (queues and rate limiting). Default: redis://redis:6379 in compose.
REDIS_URL=redis://redis:6379

# Prefix for queue and rate-limit keys, if several instances share one Redis.
# REDIS_QUEUE_PREFIX="senlo"

# Sender for triggers and campaigns that do not set one.
# DEFAULT_FROM_EMAIL="hello@example.com"

# Signs unsubscribe and tracking links instead of AUTH_SECRET. Set it if you
# want to rotate AUTH_SECRET (which signs everyone out) without breaking
# links in mail already sent.
# LINK_SIGNING_SECRET=""

# Trust the host header (required behind most VPS setups).
AUTH_TRUST_HOST=true

# Where the app's port is published on the host. The default keeps it on
# localhost, reachable only through the reverse proxy: the app takes the
# client IP for rate limits from the proxy's headers, which a client that
# reaches port 3000 directly could fake. "0.0.0.0:3000" opens it to the world
# (the old behavior; not recommended).
# APP_BIND="127.0.0.1:3000"

# Set to "false" to close public registration. Existing users still sign in.
ALLOW_REGISTRATION="true"

# GitHub sign-in.
# GITHUB_ID=""
# GITHUB_SECRET=""

# Only for the public demo instance: shows the demo banner and loads Umami.
IS_DEMO_MODE="false"
# UMAMI_WEBSITE_ID=""

# Initial users, created on first start.
# Format: '[{"name": "Admin", "email": "admin@example.com", "password": "secure_password", "role": "ADMIN"}]'
INITIAL_USERS='[]'

# Where uploaded images go. Default: the app's own disk (the uploads volume).
# For S3 or an S3-compatible service (Cloudflare R2, MinIO) set these; with
# S3_ENDPOINT the public address cannot be derived, so S3_PUBLIC_URL is
# required there (AWS derives https://<bucket>.s3.<region>.amazonaws.com).
# STORAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_PUBLIC_URL="https://files.example.com"
# S3_KEY_PREFIX="uploads"
# S3_FORCE_PATH_STYLE="true"
