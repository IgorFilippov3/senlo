{
  "name": "@senlo/features",
  "version": "1.0.0",
  "description": "Shared business features for Senlo",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:package": "tsup",
    "dev": "tsc --noEmit --watch",
    "dev:package": "tsup --watch",
    "lint": "eslint src/**/*.ts*"
  },
  "dependencies": {
    "@senlo/core": "workspace:*",
    "@senlo/ui": "workspace:*",
    "lucide-react": "^0.561.0",
    "date-fns": "^4.1.0",
    "recharts": "^2.15.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0"
  }
}
