{
  "name": "@senlo/features",
  "version": "1.0.12",
  "description": "Shared business features for Senlo",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Igor Filippov",
    "url": "https://github.com/IgorFilippov3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorFilippov3/senlo.git",
    "directory": "packages/features"
  },
  "homepage": "https://senlo.io",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api-docs": "./src/api-docs/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./api-docs": {
        "types": "./dist/api-docs.d.ts",
        "import": "./dist/api-docs.mjs",
        "require": "./dist/api-docs.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:package": "tsup",
    "dev": "tsc --noEmit --watch",
    "dev:package": "tsup --watch",
    "lint": "eslint src/**/*.ts*"
  },
  "dependencies": {
    "@scalar/api-reference-react": "0.8.20",
    "@senlo/core": "workspace:*",
    "@senlo/ui": "workspace:*",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "recharts": "^3.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
